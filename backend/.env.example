# Requerido en TODOS los entornos — sin esto /api/webhooks/revenuecat rechaza
# toda petición (fail closed). Debe coincidir con el secret configurado en
# RevenueCat dashboard → Project → Integrations → Webhooks.
REVENUECAT_WEBHOOK_SECRET=genera_uno_con__node_-e_console.log(require('crypto').randomBytes(32).toString('hex'))

# CSV de orígenes de navegador permitidos por CORS. Dejar vacío si no hay
# ningún cliente web (solo la app móvil, que no envía Origin).
ALLOWED_ORIGINS=

# PEM de la clave privada RSA usada para descifrar la clave AES de los
# uploads cifrados (ver services/uploadKeys.js). Generar con:
#   node -e "const{generateKeyPairSync}=require('crypto');const{privateKey}=generateKeyPairSync('rsa',{modulusLength:2048});console.log(privateKey.export({type:'pkcs1',format:'pem'}).toString('base64'))"
UPLOAD_RSA_PRIVATE_KEY_B64=
